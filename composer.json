{
    "name": "lessormq/messenger",
    "description": "Symfony Messenger transport for LessorMQ: the queue decides retries, delays and dead-lettering; the transport only claims, runs, acks or fails",
    "type": "symfony-bundle",
    "license": "Apache-2.0",
    "keywords": ["symfony", "messenger", "transport", "message-queue", "lessormq"],
    "require": {
        "php": ">=8.2",
        "lessormq/client": "^0.4.9",
        "psr/log": "^1.1 || ^2.0 || ^3.0",
        "symfony/dependency-injection": "^7.2",
        "symfony/http-kernel": "^7.2",
        "symfony/messenger": "^7.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "symfony/http-client": "^7.3",
        "symfony/property-access": "^7.2",
        "symfony/property-info": "^7.2",
        "symfony/serializer": "^7.2"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../php",
            "options": {"symlink": true, "versions": {"lessormq/client": "dev-main"}}
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "LessorMQ\\Messenger\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LessorMQ\\Messenger\\Tests\\": "tests/",
            "LessorMQ\\Tests\\": "../php/tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
